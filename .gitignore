*.py[oc]
build/
dist/
wheels/
*.egg-info
*.spec

# Virtual environments
.venv
venv/
env/

# 数据文件（用户本地配置，不提交）
data.json
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# 前端构建产物（vite 单文件；发版 CI 与本地 build.ps1 都会自行 npm run build，不再入库）
frontend/node_modules/
frontend/dist/
static/index.html

# PyInstaller
SSHWebTool.exe
*.exe

# 构建时收集的 VC++ 运行时 DLL（临时目录）
vcrt/

# UV
.uv-cache/

# Server config (user local, not committed; template config.example.json is committed)
config.json

# 运行时端口记录（启动时生成，不提交）
.running_port

# 自动更新过程日志（exe 同目录/TEMP，运行时生成）
_wstool_update.log

# 临时文件（调试截图 / commit message 等）
.shots/
_commit_msg.txt
_menu_*.bmp
.catpaw/

# Zig backend build output (temp)
Backend/

# IDE (trae)
.trae/
# Node deps (any level)
node_modules/
# pytest output files
pytest_out*.txt
